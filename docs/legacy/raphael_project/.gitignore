# .gitignore
# Exclude build artefacts, Gradle caches, and IDE files
/build
/.gradle
/.idea
/.cxx
/.externalNativeBuild
*.iml
*.apk
*.apks
*.aab
*.aar
*.class
*.dex
*.keystore
*.jks
# Keep runtime data directory for SQLite DB (excluded from repo)
!app/src/main/assets/data/
# Do not ignore Kotlin source directories
!app/src/main/java/**
